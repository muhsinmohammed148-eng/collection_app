# Copy this file to .env and fill in the values
# For Vercel deployment, set these as Environment Variables in your Vercel project settings

# Django secret key — generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to 'True' for local development, 'False' for production
DEBUG=False

# Comma-separated list of allowed hosts (your Vercel domain, etc.)
# If empty, Vercel URL is auto-detected
ALLOWED_HOSTS=your-app.vercel.app

# Database URL (PostgreSQL) — required for production deployment
# Vercel serverless has a read-only filesystem, so SQLite won't work.
# Get this from your database provider (e.g., Railway, Supabase, Neon, etc.)
DATABASE_URL=postgres://user:password@host:5432/dbname

# PostgreSQL SSL mode (default: require)
# Some providers may need 'verify-full', 'prefer', or 'disable'
DB_SSLMODE=require

# Vercel environment detection (set automatically by Vercel, no need to set manually)
# VERCEL=true

# SSL settings — handled automatically for Vercel deployment
# Do NOT set SECURE_SSL_REDIRECT=True on Vercel (it causes redirect loops)
