# Copy this file to .env and fill in the values
# For Vercel deployment, set these as Environment Variables in your Vercel project settings

# ========================================
# Option 1: Docker (Recommended for Local)
# ========================================
# If using Docker, you don't need this .env file.
# Just run: docker-compose up
# All settings are configured in docker-compose.yml

# ========================================
# Option 2: Local Development (No Docker)
# ========================================
# Django secret key — generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to 'True' for local development, 'False' for production
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Database URL — leave empty for SQLite, or set PostgreSQL URL
# For Docker: postgres://payflow:payflow_password@localhost:5432/payflow
DATABASE_URL=

# PostgreSQL SSL mode (default: require)
# Use 'disable' for local Docker database
DB_SSLMODE=disable

# ========================================
# Option 3: Vercel Production
# ========================================
# Set these as Environment Variables in Vercel project settings:
#   SECRET_KEY — your random secret key
#   DEBUG — False
#   DATABASE_URL — your PostgreSQL connection string (Neon, Supabase, etc.)
#   ALLOWED_HOSTS — your Vercel domain
#   CUSTOM_DOMAINS — your custom domains (comma-separated)

# Custom domains — add your custom domain(s) here (comma-separated, without https://)
# This automatically adds them to both ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS
# Example: CUSTOM_DOMAINS=collection.nexflowsoft.com,nexflowsoft.com
CUSTOM_DOMAINS=

# CSRF Trusted Origins — auto-detected from VERCEL_URL and CUSTOM_DOMAINS on Vercel
# For additional origins, add them here (comma-separated, with https:// prefix)
# CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com
